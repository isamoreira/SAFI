# Copie este arquivo para token.env e preencha com os seus dados.
# Token do bot (fale com o @BotFather no Telegram)
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz
# Seu chat id: só esse chat consegue falar com o bot (descubra com o @userinfobot)
ALLOWED_CHAT_ID=123456789
# Chave da API do Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=sua-chave-aqui
# Modelos separados por vírgula, em ordem de preferência (veja os disponíveis com listar_modelos.py)
GEMINI_MODELS=gemini-3.8-flash
